#------set methods-------

# 1- Clear

a={1,2,3,4,5}
a.clear()
print(a) #output: set()

#2-onion

b={1,2,3}
c={3,4,5}
print(b | c) #output: {1, 2, 3, 4, 5}
print(b.union(c) ) #output: {1, 2, 3, 4, 5}

#3-add

d={1,2,3}
d.add(4)
print(d) #output: {1, 2, 3, 4}

#4-copy

e={1,2,3}
f=e.copy()
print(e) #output: {1, 2, 3}
print(f) #output: {1, 2, 3}
e.add(4)
print(e) #output: {1, 2, 3, 4}
print(f) #output: {1, 2, 3}

#5-remove

g={1,2,3}
g.remove(2)
# g.remove(7)

print(g) #output: {1, 3}


#6-discard

g={1,2,3}
g.discard(2)
g.discard(7)

print(g) #output: {1, 3}
print(g) #output: {1, 3}

# 7--pop

i={"a",True,1,2,3,4}
print(i.pop()) #output: "true"

# 8--update

j={1,2,3}
k={3,4,5}
j.update(k)
print(j) #output: {1, 2, 3, 4, 5}
