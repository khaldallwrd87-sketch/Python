# ----List----

my_list1 = [1, 2, 3, 4, 5]

print(my_list1)  # Output: [1, 2, 3, 4, 5]
print(my_list1[0])  # Output: 1
print(my_list1[2])  # Output: 3
print(my_list1[4])  # Output: 5

print(my_list1[1:4])  # Output: [2, 3, 4]
print(my_list1[:4])  # Output: [1, 2, 3, 4]
print(my_list1[3:5])  # Output: [4, 5]

print(my_list1[::1])  # Output: [1, 2, 3, 4, 5]
print(my_list1[::2])  # Output: [1, 3, 5]

my_list1[1]=20
my_list1[2:4]=[30,40]
print(my_list1)  # Output: [1, 20, 30, 40, 5]
